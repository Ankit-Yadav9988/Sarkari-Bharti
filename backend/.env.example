# =============================================================================
#  RojgarHub backend -- environment template
# =============================================================================
#  These are real environment variables, not a file Spring reads on its own --
#  Spring Boot has no built-in .env support. Set them in your shell before
#  starting the app, in your IDE's run configuration, or in your host's
#  environment settings. Nothing here has a working default: the application
#  refuses to start without the four required values, which is intentional.
#
#  Windows PowerShell, current session only:
#    $env:DB_PASSWORD = 'your-db-password'
#
#  Windows, persisted for your user account:
#    setx DB_PASSWORD "your-db-password"
#
#  Linux / macOS:
#    export DB_PASSWORD='your-db-password'
# =============================================================================

# --- REQUIRED: database ------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/sarkari_portal
DB_USERNAME=postgres
DB_PASSWORD=

# --- REQUIRED: JWT signing secret -------------------------------------------
# Generate a fresh one:            openssl rand -base64 48
# No openssl on Windows? Use:      [Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))
#
# Left blank on purpose. A template that ships a working value is a template
# someone deploys verbatim, and this file is in git -- so any secret printed
# here is a public secret. The app refuses to boot on a blank value, and it
# also now rejects anything containing "dev-secret", "change-this" and similar,
# which is what the old filled-in value in this slot happened to be.
#
# Rotating this invalidates every existing admin token, which is exactly what
# you want the first time: the old repo value was a public placeholder, so any
# token minted with it must stop working. Changing the file is not enough if
# the old value was ever pushed anywhere.
JWT_SECRET=

# --- REQUIRED: admin login ---------------------------------------------------
ADMIN_USERNAME=admin
# A BCrypt hash, never the password. Generate it with:
#   mvn -q compile exec:java -Dexec.mainClass=com.sarkariportal.backend.tool.HashPassword -Dexec.args="your-password"
ADMIN_PASSWORD_HASH=

# --- REQUIRED in production: CORS -------------------------------------------
# Comma-separated exact origins. Include the deployed frontend domain or every
# API call from it fails in the browser. No wildcards, no trailing slashes.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Optional: everything below has a sane default --------------------------
SERVER_PORT=8080
DB_POOL_SIZE=10
JWT_EXPIRATION_MS=86400000
LOG_LEVEL=INFO

# Rate limits, per client IP.
RATELIMIT_LOGIN_MAX=5
RATELIMIT_LOGIN_WINDOW=900
RATELIMIT_SUBSCRIBE_MAX=3
RATELIMIT_SUBSCRIBE_WINDOW=3600

# How long one IP is ignored when re-viewing the same job (6 hours).
VIEWCOUNT_DEDUP_SECONDS=21600
