# ---- secrets / local config ----
# .env.local currently holds the API URL and is the file most likely to grow
# a real credential later. Never commit any of these.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# Spring profile files are a common place for a real DB password to land.
application-local.properties
application-prod.properties

# ---- Node / Next (frontend) ----
node_modules/
.next/
pipeline/cache/
out/
# The collector's review CSV and Markdown report are intentional workflow
# artifacts. Keep the broad `out/` rule for other build output, but allow this
# tracked directory so the workflow can commit each run for human review.
!pipeline/out/
!pipeline/out/**
.vercel
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Java / Maven (backend) ----
# backend/target is ~97 MB of build output; it must not enter git history.
target/
!.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war

# ---- logs ----
*.log
backend.log
backend/*.log

# ---- editors / OS ----
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
desktop.ini

# ---- Reticle ----
# Written by `npx @reticlehq/server init` / `login`. cloud.json holds the link to
# the Reticle Cloud workspace, so this is a credential directory and stays out of
# a public repo. Added ahead of running init rather than after, because the
# window in which it is untracked is the window in which it gets committed.
.reticle/
