# =============================================================================
#  Sarkari Bharti frontend — environment template
# =============================================================================
#  Copy to .env.local for local development. .env.local is gitignored; this
#  file is not, so nothing secret belongs here.
#
#  Every variable is NEXT_PUBLIC_*, which means Next inlines its value into the
#  browser bundle at BUILD time. Two consequences worth knowing before you
#  debug a "the variable isn't working" problem:
#
#    1. Nothing here can hold a secret. It ships to every visitor.
#    2. Changing one in your host's dashboard does nothing until you redeploy.
#       Vercel/Render rebuild on push; a bare restart will not pick it up.
# =============================================================================

# --- REQUIRED: where the Spring Boot API lives -------------------------------
# Include the /api suffix. Must be https in production, or the browser blocks
# every request from an https page as mixed content.
#   local:      http://localhost:8080/api
#   deployed:   https://sarkari-bharti-api.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# --- REQUIRED in production: this site's own origin ---------------------------
# Used for canonical tags, Open Graph URLs, JSON-LD, the sitemap and the
# WhatsApp share links. No trailing slash (one is stripped if you leave it).
#
# Leaving this unset in production is not harmless: every canonical tag then
# claims to be https://sarkari-bharti.vercel.app regardless of where the build
# is actually served, which is how a preview deploy ends up telling Google it is
# the real site. Set it explicitly per environment.
#   local:      http://localhost:3000
#   deployed:   https://sarkari-bharti.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: Google Analytics 4 --------------------------------------------
# Measurement ID from GA → Admin → Data streams → your web stream ("G-…").
# Left empty, no analytics script is loaded at all. It is also skipped unless
# this is a production build on a non-localhost origin, so `npm run dev` never
# pollutes the property.
NEXT_PUBLIC_GA_ID=

# --- Optional: search engine site verification -------------------------------
# Search Console → Add property → HTML tag. Paste ONLY the content value, not
# the whole <meta> tag. Once the domain is verified by DNS instead, this can be
# removed. Submit https://sarkari-bharti.vercel.app/sitemap.xml afterwards — the sitemap is
# generated from the live job list, so it does not need regenerating by hand.
NEXT_PUBLIC_GSC_VERIFICATION=

# Bing Webmaster Tools ("msvalidate.01" content value). Optional — Bing can
# import a verified Search Console property instead, which is less work.
NEXT_PUBLIC_BING_VERIFICATION=

# --- Optional: indexing kill switch ------------------------------------------
# Set to false on any deployment that is not the public site. /robots.txt then
# answers "Disallow: /". localhost is detected and blocked automatically, and so
# is every Vercel *preview* build (branch and pull-request deploys).
#
# A production deploy whose real address is name.vercel.app — no custom domain
# yet — is NOT treated as a preview and stays crawlable, so launching on the
# free subdomain does not keep the site out of Google.
NEXT_PUBLIC_ALLOW_INDEXING=true
